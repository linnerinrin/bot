# 文本按 LF 归一化，避免 Windows 换行污染
* text=auto

*.py    text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.csv   text eol=lf
*.txt   text eol=lf
*.env*  text eol=lf

# 资源文件一律按二进制处理，禁止换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ttc   binary
*.ttf   binary
*.otf   binary
*.mp4   binary
*.flv   binary
*.zip   binary
